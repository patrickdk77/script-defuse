{
  "name": "@patrickdk77/script-defuse",
  "version": "0.2.0",
  "description": "Inspect document scripts: PDF form scripts in JavaScript and FormCalc, from AcroForm and XFA forms, and the VBA modules of Office documents. Keeps a form script only when every call and property it uses formats, checks or calculates form fields, and a macro only when it calls nothing that reaches outside its document. Reports external access, dynamic code and obfuscation. Includes a script plugin for pdf-defuse and office-defuse.",
  "license": "MIT",
  "author": "patrickdk77",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true});require('fs').rmSync('build-test',{recursive:true,force:true})\"",
    "build": "tsc -p tsconfig.json && node scripts/write-esm-wrapper.js",
    "build:test": "tsc -p tsconfig.test.json",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "npm run lint && npm run build && npm run build:test && mocha --timeout 120000 \"build-test/test/**/*.test.js\"",
    "prepare": "husky || true",
    "prepublishOnly": "npm run clean && npm test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/patrickdk77/script-defuse.git"
  },
  "bugs": {
    "url": "https://github.com/patrickdk77/script-defuse/issues"
  },
  "homepage": "https://github.com/patrickdk77/script-defuse",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "javascript",
    "js",
    "pdf",
    "acroform",
    "acrobat",
    "form",
    "script",
    "obfuscation",
    "eval",
    "sanitize",
    "sanitizer",
    "scrub",
    "disarm",
    "defuse",
    "cdr",
    "security",
    "inspect",
    "scanner",
    "detect"
  ],
  "dependencies": {
    "acorn": "^8.19.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^18.19.130",
    "chai": "^6.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "mocha": "^12.0.3",
    "typescript": "^7.0.2"
  },
  "lint-staged": {
    "*.{ts,js,mjs,cjs,json,jsonc}": "biome check --write --no-errors-on-unmatched --files-ignore-unknown=true"
  }
}
